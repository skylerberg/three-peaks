{
  "name": "@three-peaks/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc",
    "build:prod": "node scripts/build.mjs",
    "type-check": "tsc",
    "test": "node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.test node_modules/vitest/vitest.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:bundle:static": "node scripts/check-bundle.mjs --static",
    "migrate": "node --env-file=.env --import tsx src/db/migrate-cli.ts",
    "migrate:down": "node --env-file=.env --import tsx src/db/migrate-cli.ts down",
    "migrate:test": "node --env-file=.env.test --import tsx scripts/with-test-db.ts node --import tsx src/db/migrate-cli.ts",
    "verify:backfill": "node --env-file=.env --import tsx scripts/verify-backfill.ts",
    "test:db:prune": "node --env-file=.env.test --import tsx scripts/prune-test-databases.ts",
    "kysely-codegen": "node --env-file=.env.test --import tsx scripts/codegen-types.ts",
    "openapi:dump": "node --env-file-if-exists=.env --import tsx scripts/dump-openapi.ts",
    "realtime:dump": "node --import tsx scripts/dump-realtime-events.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1000.0",
    "@google-cloud/storage": "^8.0.1",
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "~0.2.3",
    "@resvg/resvg-wasm": "^2.6.2",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "~0.2.9",
    "@three-peaks/shared": "workspace:*",
    "argon2": "~0.45.1",
    "arktype": "2.2.3",
    "hono": "~4.13.3",
    "hono-openapi": "1.3.1",
    "jose": "^6.2.10",
    "kysely": "~0.29.5",
    "openapi-types": "^12.1.3",
    "opentype.js": "^2.0.0",
    "pg": "~8.23.0",
    "redis": "^6.2.1",
    "swagger-ui-dist": "5.32.14",
    "tsx": "^4.23.12",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "kysely-codegen": "~0.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
