{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreBinaries": ["pbcopy"]
    },
    "apps/api": {
      "entry": ["scripts/*.ts", "src/db/migrations/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
      "ignore": ["src/db/types.generated.ts"]
    },
    "apps/web": {
      "entry": ["scripts/*.mjs"],
      "project": ["src/**/*.{ts,svelte}", "scripts/**/*.mjs"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/preview-edge": {
      "project": ["src/**/*.ts"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "apps/canva": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@canva/app-scripts",
        "@rspack/core",
        "@swc/core",
        "@swc/plugin-formatjs"
      ]
    },
    "apps/cli": {
      "entry": ["bin/*.mjs", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "bin/*.mjs", "scripts/*.mjs", "tests/**/*.ts"]
    }
  }
}
